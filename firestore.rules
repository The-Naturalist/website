rules_version = '2';
// Bookings: anyone can send a booking request; only the owner can see or change them.
// Field notes: anyone can read published notes; only the owner can write them.
// Paste this into Firebase console > Firestore Database > Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // Keep in sync with OWNER_EMAILS in assets/js/firebase-config.js
    function isOwner() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['thenaturalist.lk@gmail.com'];
    }

    function str(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    function validBooking(d) {
      return d.keys().hasOnly(['tour', 'tourLabel', 'date', 'days', 'guests', 'name', 'email', 'phone', 'country', 'message', 'status', 'createdAt'])
        && d.keys().hasAll(['tour', 'tourLabel', 'date', 'days', 'guests', 'name', 'email', 'status', 'createdAt'])
        && str(d.tour, 1, 40)
        && str(d.tourLabel, 1, 60)
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.days is int && d.days >= 1 && d.days <= 60
        && d.guests is int && d.guests >= 1 && d.guests <= 50
        && str(d.name, 1, 120)
        && str(d.email, 3, 200) && d.email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')
        && (!('phone' in d) || str(d.phone, 0, 40))
        && (!('country' in d) || str(d.country, 0, 80))
        && (!('message' in d) || str(d.message, 0, 3000))
        && d.status == 'new'
        && d.createdAt == request.time;
    }

    match /bookings/{id} {
      allow create: if validBooking(request.resource.data);
      allow read, delete: if isOwner();
      allow update: if isOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'ownerNote', 'updatedAt'])
        && request.resource.data.status in ['new', 'confirmed', 'declined', 'done'];
    }

    function validNote(d) {
      return d.keys().hasOnly(['title', 'body', 'category', 'topic', 'author', 'tour', 'tags', 'image', 'imageAlt', 'published', 'publishedAt', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['title', 'body', 'image', 'published', 'createdAt', 'updatedAt'])
        && str(d.title, 0, 160)
        && str(d.body, 0, 20000)
        && (!('category' in d) || str(d.category, 0, 40))
        && (!('topic' in d) || str(d.topic, 0, 80))
        && (!('author' in d) || str(d.author, 0, 80))
        && (!('tour' in d) || str(d.tour, 0, 40))
        && (!('tags' in d) || (d.tags is list && d.tags.size() <= 12))
        && str(d.image, 0, 750000)
        && (!('imageAlt' in d) || str(d.imageAlt, 0, 200))
        && d.published is bool
        && (!d.published || (d.title.size() > 0 && d.body.size() > 0 && d.image.size() > 0))
        && (!('publishedAt' in d) || d.publishedAt == null || d.publishedAt is timestamp)
        && d.createdAt is timestamp
        && d.updatedAt == request.time;
    }

    match /notes/{id} {
      allow read: if resource.data.published == true || isOwner();
      allow create: if isOwner() && validNote(request.resource.data) && request.resource.data.createdAt == request.time;
      allow update: if isOwner() && validNote(request.resource.data) && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isOwner();
    }
  }
}
